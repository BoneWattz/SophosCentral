# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role key: server-side only, lets admins create users. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only emails on this domain may sign in / be created (leave empty to allow any email)
ALLOWED_EMAIL_DOMAIN=example.com

# Default admin, used only by `npm run seed-admin` (not needed on Netlify)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Sophos Central API credentials (Sophos Central -> Global Settings -> API Credentials Management)
# Server-side only. Never prefix these with NEXT_PUBLIC_.
SOPHOS_CLIENT_ID=your-sophos-client-id
SOPHOS_CLIENT_SECRET=your-sophos-client-secret
